# Copy to .env and fill in. .env is gitignored and must never be committed.

# Brave Search API key, used for ranking data in the keyword module.
# Free tier available at https://brave.com/search/api/
# Without it, run with --no-serp to use only cached results.
BRAVE_API_KEY=

# Google PageSpeed Insights API key, used for the Lighthouse performance and
# accessibility checks. Free from Google Cloud (enable the PageSpeed Insights API).
# Without it, PSI often returns HTTP 429. You can also run with --no-pagespeed.
PSI_API_KEY=

# Contact URL advertised in the crawler's User-Agent, so site owners who see the
# requests in their logs can identify who is crawling them. Set this to your own site.
SXO_CONTACT_URL=https://example.com/
